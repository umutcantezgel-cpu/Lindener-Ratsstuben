# ═══════════════════════════════════════════════════════
# Lindener Ratsstuben — Environment Variables
# ═══════════════════════════════════════════════════════
# Kopiere diese Datei nach .env.local und fülle die Werte aus.
# cp .env.example .env.local
# ═══════════════════════════════════════════════════════

# ─── Sanity CMS ───
# Erstelle ein Projekt auf https://www.sanity.io/manage
# Die Project ID findest du unter "Project Settings"
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-04-16

# Sanity Revalidation Secret
# Erstelle ein sicheres Token (z.B. via `openssl rand -hex 32`)
# Dieses Token muss identisch sein mit dem im Sanity Webhook Dashboard
SANITY_REVALIDATE_SECRET=your_revalidate_secret_here

# Sanity Write Token (für Formular-Persistierung in CMS)
# SANITY_API_WRITE_TOKEN=your_sanity_write_token_here

# ─── Resend (E-Mail-Service) ───
# Erstelle ein Konto auf https://resend.com
# API Key: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Absender-Adresse (nach Domain-Verifizierung)
RESEND_FROM_EMAIL=Lindener Ratsstuben <noreply@lindener-ratsstuben.de>

# Admin-E-Mail für Benachrichtigungen
ADMIN_EMAIL=hasantoker38@hotmail.de

# ─── Google Maps ───
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# ─── Site URL (für Sitemap & OpenGraph) ───
NEXT_PUBLIC_SITE_URL=https://lindener-ratsstuben.de
